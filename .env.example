# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── Bullpen CLI ──────────────────────────────────────────────────────────────
# Full path to the bullpen binary if not on system PATH
# BULLPEN_PATH=/usr/local/bin/bullpen

# ─── Ledger ───────────────────────────────────────────────────────────────────
DB_PATH=./data/polygon.db

# ─── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_PORT=3000

# ─── EXECUTION LOCK ───────────────────────────────────────────────────────────
# Must be manually changed to `true` to enable live order submission.
# Even then, the dashboard "Approve" button is required per trade.
LIVE_EXECUTION_ENABLED=false

# ─── Risk Parameters ─────────────────────────────────────────────────────────
# Maximum allocation per trade as % of wallet balance
MAX_POSITION_SIZE_PCT=5
# Maximum daily loss as % of portfolio before kill switch engages
MAX_DAILY_LOSS_PCT=10
# Maximum allowable bid/ask spread (in USDC)
SPREAD_CEILING=0.05
# Order book depth must be this many times our proposed position size
LIQUIDITY_MULTIPLIER=5

# ─── Strategy Module A — Wallet Mirroring ────────────────────────────────────
# Comma-separated list of wallet addresses to track
# TRACKED_WALLETS=0xABCD...,0x1234...

# ─── Strategy Module C — News Catalyst ───────────────────────────────────────
# TWITTER_BEARER_TOKEN=
# NEWS_API_KEY=

# ─── Strategy Module B — Weather ─────────────────────────────────────────────
# No key required for NWS (US only). Open-Meteo is also keyless.
